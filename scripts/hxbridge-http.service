[Unit]
Description=ToneRelay HTTP + WebSocket server (Helix USB bridge)
After=network.target hxbridge-usb.service avahi-daemon.service
Wants=hxbridge-usb.service

[Service]
Type=simple
User=__HXBRIDGE_USER__
Group=__HXBRIDGE_USER__
SupplementaryGroups=plugdev
WorkingDirectory=__HXBRIDGE_ROOT__/hxbridge
Environment=HXBRIDGE_USB_SOCK=/tmp/hxbridge-usb.sock
ExecStart=/usr/bin/python3 __HXBRIDGE_ROOT__/hxbridge/http_server.py --host 0.0.0.0 --port __HXBRIDGE_HTTP_PORT__
__HXBRIDGE_HTTP_CAPS__
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
